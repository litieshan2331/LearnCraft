{
  "name": "@learncraft/root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=11.15.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @learncraft/web dev",
    "build:web": "pnpm --filter @learncraft/web build",
    "lint:web": "pnpm --filter @learncraft/web lint",
    "test:web": "pnpm --filter @learncraft/web test",
    "typecheck:web": "pnpm --filter @learncraft/web exec tsc --noEmit",
    "db:generate": "pnpm --filter @learncraft/web db:generate",
    "db:migrate": "pnpm --filter @learncraft/web db:migrate",
    "db:check": "pnpm --filter @learncraft/web db:check",
    "build:agent-worker": "pnpm --filter @learncraft/agent-worker-ts build",
    "eval:build": "node scripts/agent-eval-command.mjs build",
    "eval:run": "node scripts/agent-eval-command.mjs run",
    "eval:score": "node scripts/agent-eval-command.mjs score",
    "test:agent-worker": "pnpm --filter @learncraft/agent-worker-ts test",
    "typecheck:agent-worker": "pnpm --filter @learncraft/agent-worker-ts typecheck",
    "test:shared": "pnpm --filter @learncraft/security-primitives test",
    "typecheck:shared": "pnpm --filter @learncraft/security-primitives typecheck"
  }
}
