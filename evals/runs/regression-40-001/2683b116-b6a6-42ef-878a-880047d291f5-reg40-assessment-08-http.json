        "answer_key": "A",
        "explanation": "res.json() 会读取响应体并解析为 JavaScript 对象，返回 Promise 所以要 await；text() 只得到字符串，Response 对象本身也不能直接交给 JSON.parse。",
        "skill_tags": [
          "响应解析"
        ],
        "max_score": 1
      },
      {
