# 仅用于本地 Docker Compose。复制为 .env 后，请在部署环境替换全部密码与密钥。
COMPOSE_PROJECT_NAME=learncraft
WEB_PORT=3000
# 仅允许同域 Web 写入认证接口；多个 Origin 使用英文逗号分隔，不能带路径。
APP_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
# Docker Compose 的本地 HTTP 开发环境设为 false；HTTPS 的 staging/production 必须设为 true。
SESSION_COOKIE_SECURE=false

POSTGRES_DB=learncraft
POSTGRES_USER=learncraft
POSTGRES_PASSWORD=learncraft-local-postgres-change-me
# PostgreSQL 仅映射至本机，供 VS Code 数据库扩展连接。
POSTGRES_HOST_PORT=5432

# Redis 当前仅用于 Web 认证限流；固定只启用 DB 0，业务隔离使用键前缀；上线时改为生产 Secret 与受管 Redis/Sentinel。
REDIS_PASSWORD=learncraft-local-redis-change-me
# Redis 仅映射至本机，供 Redis Insight/CLI 调试。
REDIS_HOST_PORT=6379

# Celery Broker 与认证限流 Redis 物理隔离；同样只启用 DB 0，消息键使用 learncraft:celery: 前缀。
CELERY_REDIS_PASSWORD=learncraft-local-celery-redis-change-me
CELERY_REDIS_HOST_PORT=6380
CELERY_QUEUE_NAME=agent.run
CELERY_REDIS_KEY_PREFIX=learncraft:celery:
CELERY_VISIBILITY_TIMEOUT_SECONDS=660
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=480
CELERY_TASK_TIME_LIMIT_SECONDS=600
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_SECONDS=10
CELERY_RETRY_BACKOFF_MAX_SECONDS=300
CELERY_WORKER_CONCURRENCY=1

# Dispatcher 轮询 PostgreSQL Outbox 的基础参数；生产环境可按实例名区分 OUTBOX_DISPATCHER_ID。
OUTBOX_DISPATCHER_ID=agent-dispatcher-local
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_SECONDS=900
OUTBOX_MAX_ATTEMPTS=10

# TypeScript 运行时（迁移目标）使用独立队列前缀，与 Celery 的 learncraft:celery: 不共用。
# 连接串由 compose 注入为队列 Redis（celery-redis）的 DB 0。
AGENT_QUEUE_PREFIX=learncraft:agent-queue
AGENT_QUEUE_NAME=agent.run
AGENT_WORKER_CONCURRENCY=1
# 必须大于任务硬超时（600 秒），否则长任务会被判定为 stalled 而重投。
AGENT_JOB_LOCK_DURATION_MS=660000
AGENT_JOB_MAX_ATTEMPTS=3
AGENT_JOB_BACKOFF_MS=10000
AGENT_JOB_BACKOFF_MAX_MS=300000
# 第二个 Dispatcher 实例（TypeScript）的标识；必须与 OUTBOX_DISPATCHER_ID 不同。
OUTBOX_DISPATCHER_ID_TS=agent-dispatcher-ts
# 灰度路由映射：只有映射为 ts 的 run_type 由 TypeScript 运行时领取，其余仍由 Python 处理。
# 留空表示完全不接管（等价于未开始灰度）；示例：{"assessment_generate":"ts"}
AGENT_RUNTIME_ROUTES=

# MinIO 仅用于 P0 本地开发；上线时替换为托管 S3/R2。
MINIO_ROOT_USER=learncraft-minio
MINIO_ROOT_PASSWORD=learncraft-local-minio-change-me
# 本机调试端口：9000 为 S3 API，9001 为 MinIO 管理控制台。
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# 供后续 Web ↔ Worker 内部接口使用；当前健康检查尚不读取它。
INTERNAL_SERVICE_SECRET=learncraft-local-internal-secret-change-me
# Worker 仅映射给本机，用于独立调试。
AGENT_WORKER_HOST_PORT=8000

# 健康检查与版本接口使用的非敏感构建标识。
APP_VERSION=0.1.0
GIT_SHA=unknown

# 已锁定的 P0 Embedding Profile；创建向量表和迁移后不得原地修改维度或版本。
EMBEDDING_PROVIDER=SiliconFlow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_METRIC=cosine
EMBEDDING_PROFILE_VERSION=siliconflow-bge-m3-v1
# 真实密钥只填写在被 Git 忽略的 infra/.env 或部署环境 Secret Manager。
SILICONFLOW_API_KEY=

# 用户自带 Provider API Key 的 AES-256-GCM 主密钥。执行下列命令生成后仅填入被 Git 忽略的 infra/.env：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=local-v1

# 自定义模型地址的本地安全出网开关。当前尚未接通生成工作流，保持 false；
# 后续开发真实 ModelGateway 时仅可经 Agent Worker 的 SafeModelEgressClient 调用。
MODEL_EGRESS_ENABLED=true
MODEL_EGRESS_ENVIRONMENT=development
MODEL_EGRESS_PROXY_URL=
MODEL_EGRESS_CONNECT_TIMEOUT_SECONDS=10
MODEL_EGRESS_READ_TIMEOUT_SECONDS=120
MODEL_EGRESS_MAX_RESPONSE_BYTES=8388608
MODEL_EGRESS_AUDIT_RETENTION_DAYS=30

# assessment_generate 的远程 Tavily MCP 与工具预算；每次 AgentRun 最多 3 次工具调用。
TAVILY_API_KEY=
MODEL_GATEWAY_REQUEST_MAX_RETRIES=5
TAVILY_SEARCH_MAX_RESULTS=5
TAVILY_EXTRACT_TOP_RESULTS=2
TAVILY_EXTRACT_CHUNKS_PER_SOURCE=3
AGENT_TOOL_MAX_CALLS=6
TAVILY_DAILY_TOOL_CALL_LIMIT=20
TAVILY_QUOTA_REDIS_URL=
TAVILY_QUOTA_KEY_PREFIX=ratelimit:tavily:daily:

# ==================== 生产 Compose 专用变量 ====================
# 使用 infra/compose.production.yaml 时，将本文件复制为 infra/.env.production，
# 再把以下占位值和上方的本地默认值替换为生产 Secret/外部服务地址。
DATABASE_URL=postgresql://learncraft:replace-me@postgres.example.internal:5432/learncraft

# 外部认证 Redis；生产 Web 使用这组变量，固定连接 DB 0。
REDIS_HOST=redis-auth.example.internal
REDIS_PORT=6379
# 生产环境覆盖上方 REDIS_PASSWORD。

# 外部 Celery Redis Broker；未来切换 Sentinel 时填写 master 名称。
CELERY_BROKER_URL=redis://:replace-me@redis-celery.example.internal:6379/0
CELERY_BROKER_MASTER_NAME=
# 生产部署请将上方 TAVILY_QUOTA_REDIS_URL 设置为外部 Celery Redis 的 DB 0 地址。

# 生产部署时请修改文件前面的 COMPOSE_PROJECT_NAME、APP_ORIGIN、SESSION_COOKIE_SECURE、
# GIT_SHA、MODEL_EGRESS_ENVIRONMENT 和 MODEL_EGRESS_PROXY_URL；开发默认值必须保留给本地 Compose。

# 生产环境请替换上方所有 local/replace-me 值，并将真实 Secret 放入未提交的 .env.production。
