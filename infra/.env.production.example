# LearnCraft 生产环境示例。复制为被 Git 忽略的 infra/.env.production 后再填写真实值。
COMPOSE_PROJECT_NAME=learncraft-production
WEB_PORT=3000
APP_VERSION=0.1.0
GIT_SHA=replace-with-git-sha
APP_ORIGIN=https://learncraft.example.com

# 外部 PostgreSQL；生产应使用 TLS、最小权限账户与定期备份。
DATABASE_URL=postgresql://learncraft:replace-me@postgres.example.internal:5432/learncraft

# 外部认证限流 Redis，固定使用 DB 0。当前 Web 连接器使用直连 host/port；Sentinel 切换需同步升级 Web Redis 连接器。
REDIS_HOST=redis-auth.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-me

# 外部 Celery Redis Broker。首版可使用受管 Redis；未来切 Sentinel 时将 URL 改为 sentinel://host1:26379;sentinel://host2:26379/0，并填写 master 名称。
CELERY_BROKER_URL=redis://:replace-me@redis-celery.example.internal:6379/0
CELERY_BROKER_MASTER_NAME=
CELERY_QUEUE_NAME=agent.run
CELERY_REDIS_KEY_PREFIX=learncraft:celery:
CELERY_VISIBILITY_TIMEOUT_SECONDS=660
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=480
CELERY_TASK_TIME_LIMIT_SECONDS=600
CELERY_TASK_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_SECONDS=10
CELERY_RETRY_BACKOFF_MAX_SECONDS=300
CELERY_WORKER_CONCURRENCY=1

OUTBOX_DISPATCHER_ID=agent-dispatcher-production
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_SECONDS=900
OUTBOX_MAX_ATTEMPTS=10

# 仅用于 Web 与 Agent 服务之间的私有网络请求；必须使用独立随机密钥。
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-secret

# 已批准的 Embedding Profile 与生产 Provider 密钥。
EMBEDDING_PROVIDER=SiliconFlow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_METRIC=cosine
EMBEDDING_PROFILE_VERSION=siliconflow-bge-m3-v1
SILICONFLOW_API_KEY=replace-with-siliconflow-api-key

# 用户 BYOK 凭据的 AES-256-GCM 主密钥。生产环境应来自 Secret Manager，并记录可轮换的版本号。
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
CREDENTIAL_ENCRYPTION_KEY_VERSION=production-v1
